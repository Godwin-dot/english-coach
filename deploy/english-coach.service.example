[Unit]
Description=English Coach Next.js application
After=network.target

[Service]
Type=simple
User=english-coach
Group=english-coach
WorkingDirectory=/var/www/english-coach
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/var/www/english-coach/.env.local
ExecStart=/usr/bin/pnpm start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
